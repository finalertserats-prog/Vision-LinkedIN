[Unit]
# Triggered by brahmastra-codex-perms.path; see that file for the incident history.
Description=Restore group access on the shared Codex config
# A missing file is a fresh core, not an error.
ConditionPathExists=/opt/brahmastra/.codex/config.toml

[Service]
Type=oneshot
# Runs as root: the file is often root-owned after a root codex rewrote it.
# chmod 660 also resets the ACL mask to rw-, which is what re-enables the
# brahmastra group ACL.
#
# The directory is group-writable, so a group member could swap config.toml for
# a symlink to e.g. /etc/shadow and have root chmod the target. Two guards:
# find -P -type f skips symlinks, and the sandbox below makes everything outside
# the .codex directory read-only, so even a race past find cannot chmod it.
ExecStart=/usr/bin/find -P /opt/brahmastra/.codex -maxdepth 1 -name config.toml -type f -exec /bin/chmod 660 {} +

ProtectSystem=strict
ReadWritePaths=/opt/brahmastra/.codex
ProtectHome=true
PrivateTmp=true
PrivateNetwork=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_FOWNER CAP_DAC_READ_SEARCH
