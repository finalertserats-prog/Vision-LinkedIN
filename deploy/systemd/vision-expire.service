[Unit]
# Fail-closed cutoff (BRD §22.9 / FR-16): at 20:00 IST any draft that was never
# actioned by the owner is EXPIRED so it can never be posted. Skipping this run
# would let a stale draft survive past its cutoff and be published later — a
# direct breach of "un-actioned => expire, never post". One-shot + timer-driven,
# mirroring the token unit; a non-zero exit signals a failed expiry sweep to
# monitoring (see vision.cli.expire.main).
Description=VISION fail-closed draft expiry (un-actioned => expire, never post)
After=network-online.target postgresql.service
Wants=network-online.target
# Report a failed run to the owner (incident 2026-08-06: a crashed job left the
# unit in `failed` state and told nobody — the only symptom was a missing email).
# %n expands to this unit's full name, which becomes the handler's instance.
OnFailure=vision-job-failed@%n.service

[Service]
Type=oneshot
User=vision
Group=vision
WorkingDirectory=/opt/vision
EnvironmentFile=/opt/vision/.env
ExecStart=/opt/vision/venv/bin/vision-expire

# Memory guardrails — a small DB sweep, tightly bounded (same posture as token).
OOMScoreAdjust=-500
MemoryMax=384M
MemorySwapMax=0
TimeoutStartSec=300

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Writable: the whole app dir, NOT just logs. SQLite must create -wal/-journal
# files NEXT TO the database, so a logs-only grant made the DB read-only and
# every approval/publish/expire write failed with 'readonly database'.
ReadWritePaths=/opt/vision

StandardOutput=append:/opt/vision/logs/vision-expire.log
StandardError=append:/opt/vision/logs/vision-expire.log

[Install]
WantedBy=multi-user.target
