[Unit]
# Publisher poller: publishes approved-and-due drafts. Runs every ~5 minutes so
# a "Post now" click is honoured promptly. One-shot per tick; idempotent (the
# publisher itself guards against double-posting, see publish/worker.py).
Description=VISION publisher (publish approved & due drafts)
After=network-online.target postgresql.service
Wants=network-online.target
# Report a failed run to the owner (incident 2026-08-06: a crashed job left the
# unit in `failed` state and told nobody — the only symptom was a missing email).
# %n expands to this unit's full name, which becomes the handler's instance.
OnFailure=vision-job-failed@%n.service

[Service]
Type=oneshot
User=vision
Group=vision
WorkingDirectory=/opt/vision
EnvironmentFile=/opt/vision/.env
ExecStart=/opt/vision/venv/bin/vision-publisher

# Memory guardrails — small, bounded (prior VPS OOM incident).
OOMScoreAdjust=-500
MemoryMax=384M
MemorySwapMax=0
# A publish + confirmation email should be quick; cap so a hung LinkedIn call
# cannot pin the tick forever.
TimeoutStartSec=300

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Writable: the whole app dir, NOT just logs. SQLite must create -wal/-journal
# files NEXT TO the database, so a logs-only grant made the DB read-only and
# every approval/publish/expire write failed with 'readonly database'.
ReadWritePaths=/opt/vision

StandardOutput=append:/opt/vision/logs/vision-publisher.log
StandardError=append:/opt/vision/logs/vision-publisher.log

[Install]
WantedBy=multi-user.target
